# Copy to .deploy.env and fill in. That file is gitignored and must stay that way.
#
# There is no password here on purpose. Authentication is by SSH key — see the
# Deploying section of README.md for the two commands that set that up.

# cPanel username (the one you log in to the control panel with). This is the
# same Bluehost account firefighterpfister.com deploys to, so if you have that
# repo's .deploy.env handy, REMOTE_USER and REMOTE_HOST are the same values.
REMOTE_USER=yourcpanelusername

# Usually your domain, sometimes a server hostname the host gives you
# (e.g. server123.hostingcompany.com). cPanel shows this under SSH Access.
REMOTE_HOST=designoutlaw.com

# designoutlaw.com's own web root -- NOT an addon-domain subdirectory like
# firefighterpfister.com uses. This is the shared directory everything else
# on the domain already lives in, which is exactly why deploy.sh never runs
# a blanket delete against it -- see the comment in that file.
REMOTE_PATH=/home/yourcpanelusername/public_html

# Many shared hosts run SSH on a non-standard port — 2222 is common on
# Namecheap and A2, 22 elsewhere. cPanel's SSH Access page tells you.
SSH_PORT=22

# Private key used for the deploy. Must live on THIS machine — the public
# half is what gets imported and authorized in cPanel. Can be the same key
# firefighterpfister.com uses (same account), or its own — either works.
SSH_KEY=$HOME/.ssh/designoutlaw_deploy
